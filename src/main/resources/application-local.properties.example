# Copy this file to: src/main/resources/application-local.properties
# The real file is ignored by Git, so do not commit it.
#
# Based on your DB note:
# - MySQL
# - Database: defaultdb
# - Host must be the Aiven domain name, not the port
# - Port: 25170
# - SSL required

spring.datasource.url=jdbc:mysql://<aiven-host>:25170/defaultdb?sslMode=REQUIRED&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
spring.datasource.username=<db-username>
spring.datasource.password=<db-password>
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

spring.mail.username=<mail-username>
spring.mail.password=<mail-password>
